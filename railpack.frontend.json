{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": ["npm install"]
    },
    "build": {
      "commands": ["cd packages/db && npx prisma generate", "cd frontend && npm run build"]
    }
  },
  "deploy": {
    "startCommand": "cd frontend && npm start"
  }
}
