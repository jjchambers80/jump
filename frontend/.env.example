# Auth.js shared secret (MUST be the same as backend)
AUTH_SECRET="your-32-char-random-secret-here"

# Resend (magic link emails)
AUTH_RESEND_KEY="re_your_resend_api_key"

# Google OAuth
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Database (same as packages/db)
DATABASE_URL="postgresql://user:password@localhost:5432/jump?schema=public"

# API Backend URL
NEXT_PUBLIC_API_URL=http://localhost:3002

# Stripe Publishable Key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
