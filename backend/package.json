{
  "name": "jump-backend",
  "version": "0.1.0",
  "description": "Jump Ticketing Platform - Backend API",
  "main": "src/api/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/api/server.js",
    "start": "node src/api/server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:contract": "NODE_OPTIONS=--experimental-vm-modules jest tests/contract",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest tests/integration",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest tests/unit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node src/database/seeds/seed.js",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "lint": "eslint src tests --ext .js",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\""
  },
  "keywords": [
    "ticketing",
    "events",
    "qr-codes",
    "stripe"
  ],
  "author": "Jump Team",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@sendgrid/mail": "^8.1.4",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.2.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "stripe": "^17.3.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.13.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "^6.19.2",
    "supertest": "^7.0.0"
  }
}
