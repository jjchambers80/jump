// Prisma schema for Jump Ticketing Platform
// Feature: 001-online-ticket-purchase

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum EventStatus {
  DRAFT
  PUBLISHED
}

enum TicketStatus {
  VALID
  REDEEMED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum UserType {
  CUSTOMER
  ADMIN
}

// Models

model Admin {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  organization  String?
  passwordHash  String   @map("password_hash")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  events        Event[]
  sessions      Session[]

  @@map("admins")
}

model Customer {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  passwordHash  String   @map("password_hash")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  tickets              Ticket[]
  paymentTransactions  PaymentTransaction[]
  sessions             Session[]

  @@map("customers")
}

model Event {
  id           String      @id @default(uuid())
  organizerId  String      @map("organizer_id")
  name         String      @db.VarChar(255)
  date         DateTime
  venue        String      @db.VarChar(500)
  capacity     Int
  ticketPrice  Decimal     @map("ticket_price") @db.Decimal(10, 2)
  status       EventStatus @default(DRAFT)
  createdAt    DateTime    @default(now()) @map("created_at")

  // Relations
  organizer            Admin                @relation(fields: [organizerId], references: [id])
  tickets              Ticket[]
  paymentTransactions  PaymentTransaction[]

  @@index([status], name: "idx_event_status")
  @@index([date], name: "idx_event_date")
  @@index([organizerId], name: "idx_event_organizer")
  @@map("events")
}

model Ticket {
  id           String       @id @default(uuid())
  eventId      String       @map("event_id")
  customerId   String       @map("customer_id")
  purchaseTime DateTime     @default(now()) @map("purchase_time")
  pricePaid    Decimal      @map("price_paid") @db.Decimal(10, 2)
  qrCodeJwt    String       @map("qr_code_jwt") @db.Text
  status       TicketStatus @default(VALID)
  stripeTxId   String?      @map("stripe_tx_id")

  // Relations
  event    Event    @relation(fields: [eventId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([eventId], name: "idx_ticket_event")
  @@index([customerId], name: "idx_ticket_customer")
  @@index([stripeTxId], name: "idx_ticket_stripe_tx")
  @@index([status], name: "idx_ticket_status")
  @@map("tickets")
}

model PaymentTransaction {
  id                String        @id @default(uuid())
  stripeSessionId   String        @unique @map("stripe_session_id")
  customerId        String        @map("customer_id")
  eventId           String        @map("event_id")
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("USD") @db.VarChar(3)
  status            PaymentStatus @default(PENDING)
  timestamp         DateTime      @default(now())
  failureReason     String?       @map("failure_reason") @db.Text

  // Relations
  customer Customer @relation(fields: [customerId], references: [id])
  event    Event    @relation(fields: [eventId], references: [id])

  @@index([customerId], name: "idx_payment_customer")
  @@index([eventId], name: "idx_payment_event")
  @@index([status], name: "idx_payment_status")
  @@map("payment_transactions")
}

model Session {
  id         String   @id @default(uuid())
  adminId    String?  @map("admin_id")
  customerId String?  @map("customer_id")
  userType   UserType @map("user_type")
  token      String   @unique @db.VarChar(255)
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  // Discriminated relations - exactly one must be set based on userType
  admin    Admin?    @relation(fields: [adminId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([token], name: "idx_session_token")
  @@index([expiresAt], name: "idx_session_expires")
  @@map("sessions")
}
