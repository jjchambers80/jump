# Auth.js shared secret (MUST be the same as frontend)
AUTH_SECRET="your-32-char-random-secret-here"

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/jump?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Stripe
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"
# Stripe Connect payouts (spec 010 phase 2). Off by default; the Connect endpoint has its own secret.
# STRIPE_CONNECT_ENABLED=true
# STRIPE_CONNECT_WEBHOOK_SECRET="whsec_your_connect_webhook_secret"

# Applications (spec 011). Off = FREE forms only. On = PAID forms open: card on
# file at submission, off-session charge at approval, pay-now, refunds.
# APPLICATIONS_PAYMENTS_ENABLED=true

# Legal acceptances (spec 024 phase 3). LEGAL_IP_SALT salts the hashed IP on
# consent rows (falls back to AUTH_SECRET); LEGAL_ACCEPTANCE_REQUIRED=true makes
# checkout refuse a client that sends no acceptances — flip it with the legal pages.
# LEGAL_IP_SALT=
# LEGAL_ACCEPTANCE_REQUIRED=true
# Overdue pay-now sweep interval (default 1 h)
# APPLICATION_SWEEP_INTERVAL_MS=3600000

# Resend
RESEND_API_KEY="re_your_resend_api_key"

# Server
PORT=3000
NODE_ENV=development

# CORS — comma-separated list of allowed origins. Outside production any
# http://localhost:<port> origin is also accepted (worktree/preview servers).
FRONTEND_URL="http://localhost:3001"
