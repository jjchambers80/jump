# Auth.js shared secret (MUST be the same as frontend)
AUTH_SECRET="your-32-char-random-secret-here"

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/jump?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Stripe
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# Resend
RESEND_API_KEY="re_your_resend_api_key"

# Server
PORT=3000
NODE_ENV=development

# CORS — comma-separated list of allowed origins. Outside production any
# http://localhost:<port> origin is also accepted (worktree/preview servers).
FRONTEND_URL="http://localhost:3001"

# Public base URL of this backend (absolute links in emails and wallet passes).
# Falls back to https://$RAILWAY_PUBLIC_DOMAIN, then http://localhost:$PORT
# BACKEND_URL="https://api.jump.events"

# Apple Wallet passes — all five required to enable (see specs/006-wallet-passes/quickstart.md)
# APPLE_PASS_TYPE_ID="pass.events.jump.ticket"
# APPLE_TEAM_ID="ABCDE12345"
# APPLE_PASS_CERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# APPLE_PASS_KEY_PEM="-----BEGIN ENCRYPTED PRIVATE KEY-----\n...\n-----END ENCRYPTED PRIVATE KEY-----"
# APPLE_PASS_KEY_PASSPHRASE="..."
# APPLE_WWDR_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Google Wallet passes — first three required to enable
# GOOGLE_WALLET_ISSUER_ID="3388000000012345678"
# GOOGLE_WALLET_SA_EMAIL="wallet@your-project.iam.gserviceaccount.com"
# GOOGLE_WALLET_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# GOOGLE_WALLET_ORIGINS="https://jump.events"   # defaults to FRONTEND_URL
