// Prisma schema for Jump Ticketing Platform
// Feature: 003-schema-redesign — MVP Data Architecture
// Package: @jump/db (packages/db)

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// Auth.js v5 Required Models
// ──────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerified   DateTime?
  name            String?
  image           String?

  // Custom fields (ignored by Auth.js adapter)
  firstName       String?
  lastName        String?
  role            UserRole  @default(CUSTOMER)
  organizationId  String?
  isActive        Boolean   @default(true)
  deletedAt       DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Auth.js relations
  accounts        Account[]

  // Domain relations
  organization    Organization? @relation(fields: [organizationId], references: [id])
  contacts        Contact[]

  @@index([organizationId])
  @@index([role])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ──────────────────────────────────────────────
// Content-Addressed File Storage
// ──────────────────────────────────────────────

model File {
  id           String   @id @default(cuid())
  hash         String   @unique
  mimeType     String
  sizeBytes    Int
  originalName String?
  createdAt    DateTime @default(now())

  images Image[]
}

model Image {
  id        String   @id @default(cuid())
  fileId    String
  usageType String
  focalX    Float    @default(0.5)
  focalY    Float    @default(0.5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  file   File    @relation(fields: [fileId], references: [id])
  venues Venue[]
  events Event[]

  @@index([fileId])
  @@index([usageType])
}

// ──────────────────────────────────────────────
// Domain Models
// ──────────────────────────────────────────────

model Organization {
  id               String             @id @default(cuid())
  name             String
  status           OrganizationStatus @default(ACTIVE)
  businessType     String?
  nickname         String?
  countryCode      String?            @default("US")
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  postalCode       String?
  phoneCountryCode String?            @default("+1")
  phoneNumber      String?
  ein              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venues      Venue[]
  users       User[]
  people      OrganizationPerson[]
  tierPresets TierPreset[]
}

model OrganizationPerson {
  id                      String       @id @default(cuid())
  organizationId          String
  firstName               String
  lastName                String
  dateOfBirth             DateTime     @db.Date
  isAccountRepresentative Boolean      @default(false)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // A partial unique index in the SQL migration enforces one account representative per organization.
  @@index([organizationId])
}

model Venue {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  address        String
  city           String?
  state          String?
  postalCode     String?
  logoUrl        String?
  imageId        String?
  timezone       String       @default("America/New_York")
  isPublic       Boolean      @default(true)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  image          Image?       @relation(fields: [imageId], references: [id])
  events         Event[]

  @@index([organizationId])
}

model Contact {
  id        String   @id @default(cuid())
  email     String   @unique
  firstName String
  lastName  String

  userId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders    Order[]
  tickets   Ticket[]

  @@index([userId])
  @@index([email])
}

model Event {
  id          String      @id @default(cuid())
  venueId     String
  name        String
  description String?
  logoUrl     String?
  imageId     String?
  date        DateTime
  capacity    Int
  category    String?
  status      EventStatus @default(DRAFT)
  taxRate     Decimal?    @db.Decimal(6, 5)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  venue       Venue       @relation(fields: [venueId], references: [id])
  image       Image?      @relation(fields: [imageId], references: [id])
  priceTiers  PriceTier[]
  orders      Order[]
  tickets     Ticket[]

  @@index([venueId])
  @@index([status])
  @@index([date])
}

model PriceTier {
  id               String          @id @default(cuid())
  eventId          String
  name             String
  description      String?
  price            Decimal         @db.Decimal(10, 2)
  quantityTotal    Int
  quantitySold     Int             @default(0)
  quantityReserved Int             @default(0)
  displayOrder     Int             @default(0)
  minPerOrder      Int?
  maxPerOrder      Int?
  isActive         Boolean         @default(true)
  saleStartDate    DateTime?
  saleEndDate      DateTime?
  visibility       TierVisibility  @default(PUBLIC)
  isRefundable     Boolean         @default(false)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  event            Event    @relation(fields: [eventId], references: [id])
  tickets          Ticket[]
  orderItems       OrderItem[]

  @@index([eventId])
  @@index([eventId, isActive])
}

model TierPreset {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  description    String?
  price          Decimal        @db.Decimal(10, 2)
  displayOrder   Int            @default(0)
  minPerOrder    Int?
  maxPerOrder    Int?
  visibility     TierVisibility @default(PUBLIC)
  isRefundable   Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Order {
  id              String      @id @default(cuid())
  eventId         String
  contactId       String
  stripeSessionId String?     @unique
  orderRef        String      @unique
  totalAmount         Decimal     @db.Decimal(10, 2)
  subtotalAmount      Decimal     @db.Decimal(10, 2)  @default(0)
  platformFeeAmount   Decimal     @db.Decimal(10, 2)  @default(0)
  processingFeeAmount Decimal     @db.Decimal(10, 2)  @default(0)
  taxAmount           Decimal     @db.Decimal(10, 2)  @default(0)
  currency        String      @default("usd")
  quantity        Int
  status          OrderStatus @default(PENDING)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  event           Event       @relation(fields: [eventId], references: [id])
  contact         Contact     @relation(fields: [contactId], references: [id])
  tickets         Ticket[]
  items           OrderItem[]
  payment         PaymentTransaction?
  refunds         Refund[]

  @@index([eventId])
  @@index([contactId])
  @@index([status])
  @@index([orderRef])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  priceTierId String
  quantity      Int
  unitPrice     Decimal  @db.Decimal(10, 2)
  platformFee   Decimal  @db.Decimal(10, 2)  @default(0)
  processingFee Decimal  @db.Decimal(10, 2)  @default(0)
  createdAt     DateTime @default(now())

  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  priceTier   PriceTier @relation(fields: [priceTierId], references: [id])

  @@unique([orderId, priceTierId])
  @@index([orderId])
  @@index([priceTierId])
}

model Ticket {
  id           String       @id @default(cuid())
  orderId      String
  eventId      String
  priceTierId  String
  contactId    String
  ticketNumber Int
  pricePaid    Decimal      @db.Decimal(10, 2)
  barcode      String       @unique
  qrCodeJwt    String?
  status       TicketStatus @default(VALID)
  redeemedAt   DateTime?

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  order        Order        @relation(fields: [orderId], references: [id])
  event        Event        @relation(fields: [eventId], references: [id])
  priceTier    PriceTier    @relation(fields: [priceTierId], references: [id])
  contact      Contact      @relation(fields: [contactId], references: [id])
  refunds      Refund[]

  @@unique([eventId, ticketNumber])
  @@index([orderId])
  @@index([eventId])
  @@index([priceTierId])
  @@index([contactId])
  @@index([barcode])
  @@index([status])
}

model PaymentTransaction {
  id                    String        @id @default(cuid())
  orderId               String        @unique
  stripePaymentIntentId String?       @unique
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("usd")
  status                PaymentStatus @default(PENDING)
  failureReason         String?

  createdAt             DateTime      @default(now())
  // NO updatedAt — append-only per constitution

  order                 Order         @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
}

model Refund {
  id              String       @id @default(cuid())
  orderId         String
  ticketId        String?      // null = full order refund
  stripeRefundId  String?
  amount          Decimal      @db.Decimal(10, 2)
  reason          String?
  status          RefundStatus @default(PENDING)
  initiatedBy     String?      // userId of admin who initiated, null for customer self-service

  createdAt       DateTime     @default(now())
  // NO updatedAt — append-only ledger

  order           Order        @relation(fields: [orderId], references: [id])
  ticket          Ticket?      @relation(fields: [ticketId], references: [id])

  @@index([orderId])
  @@index([ticketId])
  @@index([stripeRefundId])
}

// ──────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  ORGANIZER
  ADMIN
  SYSTEM_ADMIN
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum TierVisibility {
  PUBLIC
  PRIVATE
  HIDDEN
}

enum TicketStatus {
  VALID
  REDEEMED
  EXPIRED
  VOIDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}
