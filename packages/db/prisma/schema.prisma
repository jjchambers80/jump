// Prisma schema for Jump Ticketing Platform
// Feature: 003-schema-redesign — MVP Data Architecture
// Package: @jump/db (packages/db)

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// Auth.js v5 Required Models
// ──────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?

  // Custom fields (ignored by Auth.js adapter)
  firstName String?
  lastName  String?
  role      UserRole  @default(UNASSIGNED)
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  // Spec 030: account settings › General. Personal to the User, never to an
  // organization. `image` stays the Auth.js/Google picture fallback; an
  // uploaded photo lives in `avatarImage`. `timeZone` null = browser default.
  phone         String?
  locale        String    @default("en-US")
  timeZone      String?
  avatarImageId String?   @unique
  pendingEmail  String?
  avatarImage   Image?    @relation("UserAvatar", fields: [avatarImageId], references: [id])

  // Spec 030 › Security (feature B). Password is optional — magic link and
  // Google remain; the hash is "scrypt$N$r$p$salt$hash" (Node crypto, no
  // native dependency). Secondary email = recovery + security notices.
  passwordHash             String?
  passwordUpdatedAt        DateTime?
  secondaryEmail           String?
  secondaryEmailVerifiedAt DateTime?
  passkeys                 Passkey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Auth.js relations
  accounts Account[]

  // Domain relations. Staff belong to organizations via OrganizationMember;
  // buyers are Contact rows and never link here (spec 007).
  memberships       OrganizationMember[]
  // Spec 022: organizations this user signed up (owner of the Jump account)
  platformCustomers PlatformCustomer[]
  // Spec 030: revocable sessions (Devices) and the security audit trail
  sessions       UserSession[]
  securityEvents SecurityEvent[]

  @@index([role])
  @@index([email])
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Spec 030 feature D: one row per signed-in browser. The JWT carries the row
// id as `sid`; the backend rejects a revoked one immediately and the Auth.js
// claims refresh (≤ 60 s) drops the cookie. Raw IPs are never stored.
model UserSession {
  id         String    @id @default(cuid())
  userId     String
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  revokedBy  String? // user | logout-all | sign-out | password-change | two-step | sweep
  userAgent  String?
  deviceType String? // desktop | mobile | tablet | unknown
  os         String?
  browser    String?
  ipHash     String?
  city       String?
  region     String?
  country    String? // ISO 3166-1 alpha-2
  provider   String? // resend | google | password | passkey | dev-email

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([lastSeenAt])
}

// Spec 030 B: WebAuthn credentials (discoverable). Private keys never reach Jump.
model Passkey {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique // base64url
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]
  deviceType   String // singleDevice | multiDevice
  backedUp     Boolean   @default(false)
  aaguid       String?
  label        String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Spec 030: append-only audit trail of account security mutations (no updatedAt).
model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String
  type      String
  ipHash    String?
  userAgent String?
  meta      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ──────────────────────────────────────────────
// Content-Addressed File Storage
// ──────────────────────────────────────────────

model File {
  id           String   @id @default(cuid())
  hash         String   @unique
  mimeType     String
  sizeBytes    Int
  originalName String?
  createdAt    DateTime @default(now())

  images     Image[]
  storeFiles StoreFile[]
}

model Image {
  id        String   @id @default(cuid())
  fileId    String
  usageType String
  focalX    Float    @default(0.5)
  focalY    Float    @default(0.5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  file                   File                    @relation(fields: [fileId], references: [id])
  venues                 Venue[]
  events                 Event[]
  organizationLogos      Organization[]          @relation("OrgLogo")
  organizationCovers     Organization[]          @relation("OrgCover")
  applicantProfileImages ApplicantProfileImage[]
  applicationAnswers     ApplicationAnswer[]
  storeFile              StoreFile?
  userAvatars            User[]                  @relation("UserAvatar")

  @@index([fileId])
  @@index([usageType])
}

// Spec 025: Content › Files. An organization's uploaded asset (image or PDF)
// with a public, hash-protected URL. Bytes live in the shared content-addressed
// File table (two organizations uploading the same PDF share one File); images
// also get an Image row for variants and the focal point.
model StoreFile {
  id             String   @id @default(cuid())
  organizationId String
  fileId         String
  imageId        String?  @unique
  // Display name without extension; the extension comes from the sniffed type.
  name           String
  extension      String
  altText        String?
  width          Int?
  height         Int?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  file         File                 @relation(fields: [fileId], references: [id])
  image        Image?               @relation(fields: [imageId], references: [id])
  references   StoreFileReference[]
  featuredIn   BlogPost[]

  @@index([organizationId, createdAt])
  @@index([organizationId, name])
  @@index([fileId])
}

// Spec 026: Content › Blog posts. A Blog is the Shopify-style container
// (the organizer's "category") with its own handle and listing URL
// /organizations/:orgId/blogs/:handle; every organization gets "News" lazily.
model Blog {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  handle         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  posts        BlogPost[]

  @@unique([organizationId, handle])
}

// content / excerpt are server-sanitised HTML snapshots from the editor.
// Public when isVisible and publishedAt is null or in the past; a future
// publishedAt is "Scheduled".
model BlogPost {
  id             String    @id @default(cuid())
  organizationId String
  blogId         String
  title          String
  handle         String
  content        String
  excerpt        String?
  authorName     String
  tags           String[]  @default([])
  featuredFileId String?
  isVisible      Boolean   @default(false)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  blog         Blog         @relation(fields: [blogId], references: [id])
  featuredFile StoreFile?   @relation(fields: [featuredFileId], references: [id], onDelete: SetNull)

  @@unique([blogId, handle])
  @@index([organizationId, updatedAt])
  @@index([blogId, isVisible, publishedAt])
}

// Spec 027: Content › Menus — storefront navigation. main-menu renders in the
// organization header, footer-menu in the storefront footer; both are created
// lazily per organization and cannot be deleted. Items form a tree (3 levels).
enum MenuLinkType {
  HOME
  EVENTS
  EVENT
  VENUE
  PAGE
  BLOG
  BLOG_POST
  ACCOUNT
  EXTERNAL
}

model Menu {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  handle         String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        MenuItem[]

  @@unique([organizationId, handle])
}

// targetId has no foreign key on purpose: a deleted page must not delete the
// menu item — the editor shows "Broken link" and the storefront skips it.
model MenuItem {
  id       String       @id @default(cuid())
  menuId   String
  parentId String?
  position Int
  label    String
  linkType MenuLinkType
  targetId String?
  url      String?
  newTab   Boolean      @default(false)

  menu     Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   MenuItem?  @relation("MenuItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuItemChildren")

  @@index([menuId, parentId, position])
}

// Spec 028: Content › URL redirects. A storefront request that would 404 on
// the organization's storefront is answered with a 301 to `toPath` (a
// storefront path such as /pages/faq, or an absolute http(s) URL).
// fromPath is normalised: lowercase, leading "/", no trailing "/".
model UrlRedirect {
  id             String   @id @default(cuid())
  organizationId String
  fromPath       String
  toPath         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, fromPath])
}

enum ContentRefKind {
  PAGE
  BLOG_POST
}

// Which content records use a file (featured image, or an <img>/<a> inside
// stored HTML). Rebuilt on every save of the referencing record; rows die
// with the file (cascade) and with the record (service delete).
model StoreFileReference {
  id       String         @id @default(cuid())
  fileId   String
  kind     ContentRefKind
  targetId String
  field    String

  file StoreFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, kind, targetId, field])
  @@index([kind, targetId])
}

// ──────────────────────────────────────────────
// Domain Models
// ──────────────────────────────────────────────

model Organization {
  id                        String             @id @default(cuid())
  name                      String
  // URL handle for the admin org page (/admin/organization/[slug]). Generated
  // from the name at creation, stable across renames; editable via PATCH.
  // The cuid() default only covers direct prisma.organization.create calls
  // (tests, seed); OrganizationService always sets a name-derived slug.
  slug                      String             @unique @default(cuid())
  status                    OrganizationStatus @default(ACTIVE)
  companyName               String?
  email                     String?
  businessType              String?
  nickname                  String?
  countryCode               String?            @default("US")
  addressLine1              String?
  addressLine2              String?
  city                      String?
  state                     String?
  postalCode                String?
  phoneCountryCode          String?            @default("+1")
  phoneNumber               String?
  ein                       String?
  logoUrl                   String?
  logoImageId               String?
  coverUrl                  String?
  coverImageId              String?
  brandColor                String?
  themeMode                 ThemeMode          @default(SYSTEM)
  // Spec 009 phase 3: listed tier prices already include sales tax; tax is
  // backed out at the event's rate instead of added on top.
  taxInclusivePricing       Boolean            @default(false)
  // Spec 010 phase 1: what buyers see on their card statement (suffix after the
  // platform prefix; null = derived from name) and which optional Stripe payment
  // methods this organization offers at checkout (subset of the allowlist).
  statementDescriptorSuffix String?
  enabledPaymentMethods     String[]           @default([])
  paymentSettingsUpdatedAt  DateTime?
  // Spec 011 phase 3: daily email to members summarising new application
  // submissions. `applicationDigestAt` is the end of the last window sent.
  applicationDigestEnabled  Boolean            @default(true)
  applicationDigestAt       DateTime?
  // Spec 022: null while the /signup flow is in progress (OnboardingService
  // sets it explicitly); direct creates (tests, seed, POST /organizations)
  // are onboarded at once. Pending organizations are hidden from the org
  // switcher and swept when abandoned.
  onboardingCompletedAt     DateTime?          @default(now())
  // Spec 022: the organizer dismissed the dashboard setup guide.
  setupGuideDismissedAt     DateTime?
  // Online Store › Preferences. Private mode hides the storefront behind a
  // password (scrypt hash; never returned by the API) with an optional message
  // for visitors. seoTitle/seoDescription are the storefront homepage's
  // <title> and meta description. autoRedirectLanguage (Automatic redirection
  // › Language) is stored for the day the storefront is localized; nothing
  // reads it yet.
  storefrontPrivate         Boolean            @default(false)
  storefrontPasswordHash    String?
  storefrontMessage         String?
  seoTitle                  String?
  seoDescription            String?
  autoRedirectLanguage      Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  platformCustomer         PlatformCustomer?
  logoImage                Image?                       @relation("OrgLogo", fields: [logoImageId], references: [id])
  coverImage               Image?                       @relation("OrgCover", fields: [coverImageId], references: [id])
  venues                   Venue[]
  members                  OrganizationMember[]
  contacts                 Contact[]
  domains                  OrganizationDomain[]
  people                   OrganizationPerson[]
  tierPresets              TierPreset[]
  taxRegions               TaxRegion[]
  applicantProfiles        ApplicantProfile[]
  applicationTemplates     ApplicationMessageTemplate[]
  applicationFormTemplates ApplicationFormTemplate[]
  stripeAccounts           OrganizationStripeAccount[]
  pages                    Page[]
  storeFiles               StoreFile[]
  blogs                    Blog[]
  blogPosts                BlogPost[]
  menus                    Menu[]
  urlRedirects             UrlRedirect[]
}

// Custom content pages managed under Online Store. Content is stored as the
// editor's HTML snapshot; rendering/sanitization belongs to the storefront.
model Page {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  // URL handle, unique per organization: /organizations/:orgId/pages/:slug.
  // Derived from the title unless the organizer sets one (search engine listing).
  slug           String
  content        String
  isVisible      Boolean  @default(true)
  // Search engine listing overrides; null falls back to title / no description.
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@index([organizationId, createdAt])
}

// Spec 010 phase 2: the organization's Stripe Connect (Express) account that
// receives destination-charge transfers and pays out to its bank. One row per
// organization per Stripe mode (test/live); rows for the other mode are ignored.
// State is written only from Stripe Account objects (sync + Connect webhook).
model OrganizationStripeAccount {
  id                String    @id @default(cuid())
  organizationId    String
  mode              String // 'test' | 'live' — stripeMode() when created
  stripeAccountId   String    @unique // acct_…
  chargesEnabled    Boolean   @default(false)
  transfersEnabled  Boolean   @default(false) // capabilities.transfers === 'active' — the routing gate
  payoutsEnabled    Boolean   @default(false)
  detailsSubmitted  Boolean   @default(false)
  disabledReason    String? // requirements.disabled_reason
  currentlyDue      String[]  @default([]) // requirements.currently_due (field names only)
  bankName          String? // display snapshot from external_accounts (default_for_currency)
  bankLast4         String?
  currency          String?
  payoutInterval    String? // daily | weekly | monthly | manual
  payoutAnchor      String? // weekly_anchor or monthly_anchor
  payoutDelayDays   Int?
  payoutDescriptor  String? // settings.payouts.statement_descriptor
  lastPayoutAt      DateTime?
  lastPayoutFailure String?
  disconnectedAt    DateTime?
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, mode])
  @@index([stripeAccountId])
}

// White-label storefront hostname owned by an organization (spec 007 phase 3).
// PENDING: records shown, not yet proven. VERIFIED: TXT + CNAME resolve; TLS
// being provisioned. ACTIVE: serving; storefront URLs use it. FAILED: a
// previously verified domain has not resolved for 72h.
model OrganizationDomain {
  id                String       @id @default(cuid())
  organizationId    String
  hostname          String       @unique // lowercase, no scheme/port/path
  status            DomainStatus @default(PENDING)
  verificationHost  String       @default("_jump-verify") // label(s) prepended to hostname for the ownership TXT
  verificationToken String // full TXT value, e.g. "jump-verify=<hex>" or Railway's "railway-verify=<token>"
  cnameTarget       String // what <hostname> must CNAME to
  isPrimary         Boolean      @default(false)
  railwayDomainId   String? // Railway custom-domain id when the API is configured
  certificateStatus String? // PENDING | ISSUED | FAILED, from Railway; null when TLS is not managed here
  dnsProvider       String? // detected from the zone's NS records (see lib/dnsProvider.js); null when unknown
  lastDnsSnapshot   Json? // { cname: { currentValue, status }, txt: { currentValue, status } } from the last check
  verifiedAt        DateTime?
  lastCheckedAt     DateTime?
  failingSince      DateTime? // first failed check after a success; cleared on success
  lastError         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
}

// Staff membership: which organizations a User can administer, and in what role.
// Replaces User.organizationId so one person can belong to several organizations.
// Spec 022: the organization's relationship with Jump — who signed up, which
// plan, the Stripe Billing customer (in Jump's own Stripe account) and the
// onboarding survey answers. Distinct from Contact (the organization's own
// buyers and applicants) and from the Auth.js Account model. One row per
// organization, created when onboarding completes or when the organizer
// starts a subscription, whichever comes first.
model PlatformCustomer {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  ownerUserId          String
  plan                 PlatformPlan @default(FREE)
  stripeCustomerId     String?      @unique
  stripeSubscriptionId String?      @unique
  subscriptionStatus   String?
  trialEndsAt          DateTime?
  currentPeriodEndsAt  DateTime?
  // { version, goals[], eventTypes[], eventsPerYear, attendance, movingFrom,
  //   surveySkippedAt, subscribeSkippedAt, source }
  onboarding           Json?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User         @relation(fields: [ownerUserId], references: [id])

  @@index([ownerUserId])
}

model OrganizationMember {
  id             String     @id @default(cuid())
  userId         String
  organizationId String
  role           MemberRole
  createdAt      DateTime   @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model OrganizationPerson {
  id                      String   @id @default(cuid())
  organizationId          String
  firstName               String
  lastName                String
  dateOfBirth             DateTime @db.Date
  isAccountRepresentative Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // A partial unique index in the SQL migration enforces one account representative per organization.
  @@index([organizationId])
}

model Venue {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  address        String
  city           String?
  state          String?
  postalCode     String?
  logoUrl        String?
  imageId        String?
  timezone       String  @default("America/New_York")
  isPublic       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  image        Image?       @relation(fields: [imageId], references: [id])
  events       Event[]

  @@index([organizationId])
}

// Buyer record, scoped per organization. The same email at two organizations is
// two rows with separate notes, consent, and order history. Buyers never live in User.
model Contact {
  id                    String                 @id @default(cuid())
  organizationId        String
  email                 String
  firstName             String
  lastName              String
  location              String?
  note                  String?
  emailSubscribed       Boolean                @default(false)
  // Marketing consent provenance (spec 023 LR-07, built by spec 024 phase 3)
  emailSubscribedAt     DateTime?
  emailSubscribedSource EmailSubscribedSource?
  emailUnsubscribedAt   DateTime?
  accountCreatedAt      DateTime? // null = guest checkout; set = login-enabled buyer account
  stripeCustomerId      String?                @unique // spec 011: platform-account Customer holding the applicant's saved card

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id])
  orders            Order[]
  tickets           Ticket[]
  loginTokens       BuyerLoginToken[]
  applicantProfiles ApplicantProfile[]
  applications      Application[]

  @@unique([organizationId, email])
  @@index([email])
}

// Single-use, hashed magic-link token for passwordless buyer sign-in.
// WELCOME tokens are issued at purchase when the buyer opted into an account;
// LOGIN tokens are requested from the storefront. Raw token is never stored.
model BuyerLoginToken {
  id             String            @id @default(cuid())
  contactId      String
  organizationId String
  tokenHash      String            @unique
  purpose        BuyerTokenPurpose
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime          @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([expiresAt])
}

model Event {
  id            String      @id @default(cuid())
  venueId       String
  name          String
  description   String?
  logoUrl       String?
  imageId       String?
  date          DateTime
  capacity      Int
  category      String?
  status        EventStatus @default(DRAFT)
  taxRate       Decimal?    @db.Decimal(6, 5)
  taxRateSource TaxSource?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue            Venue             @relation(fields: [venueId], references: [id])
  image            Image?            @relation(fields: [imageId], references: [id])
  priceTiers       PriceTier[]
  orders           Order[]
  tickets          Ticket[]
  applicationForms ApplicationForm[]
  applications     Application[]
  addOns           AddOn[]

  @@index([venueId])
  @@index([status])
  @@index([date])
}

model PriceTier {
  id               String         @id @default(cuid())
  eventId          String
  name             String
  description      String?
  price            Decimal        @db.Decimal(10, 2)
  quantityTotal    Int
  quantitySold     Int            @default(0)
  quantityReserved Int            @default(0)
  displayOrder     Int            @default(0)
  minPerOrder      Int?
  maxPerOrder      Int?
  isActive         Boolean        @default(true)
  saleStartDate    DateTime?
  saleEndDate      DateTime?
  visibility       TierVisibility @default(PUBLIC)
  isRefundable     Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event      Event            @relation(fields: [eventId], references: [id])
  tickets    Ticket[]
  orderItems OrderItem[]
  addOns     PriceTierAddOn[]

  @@index([eventId])
  @@index([eventId, isActive])
}

// Spec 009: per-organization tax collection by region (US state).
// Rows are created when an organization configures a region on Settings › Tax;
// a region with venues but no row is "not set" and collects no tax.
model TaxRegion {
  id             String     @id @default(cuid())
  organizationId String
  country        String     @default("US")
  region         String
  collecting     Boolean    @default(false)
  source         TaxSource  @default(STRIPE)
  manualRate     Decimal?   @db.Decimal(6, 5)
  lastRate       Decimal?   @db.Decimal(6, 5)
  lastSource     TaxSource?
  lastCheckedAt  DateTime?
  lastError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, country, region])
  @@index([organizationId])
}

model TierPreset {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  description    String?
  price          Decimal        @db.Decimal(10, 2)
  displayOrder   Int            @default(0)
  minPerOrder    Int?
  maxPerOrder    Int?
  visibility     TierVisibility @default(PUBLIC)
  isRefundable   Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// One row per transaction: a ticket purchase (kind TICKET) or a paid
// application (kind APPLICATION, spec 024). The application keeps its review
// lifecycle on Application; every money column, the Stripe payment and the
// refunds live here. FREE-form applications have no order.
model Order {
  id                  String      @id @default(cuid())
  kind                OrderKind   @default(TICKET)
  eventId             String
  contactId           String
  applicationId       String?     @unique
  stripeSessionId     String?     @unique
  orderRef            String      @unique
  totalAmount         Decimal     @db.Decimal(10, 2)
  subtotalAmount      Decimal     @default(0) @db.Decimal(10, 2)
  platformFeeAmount   Decimal     @default(0) @db.Decimal(10, 2)
  processingFeeAmount Decimal     @default(0) @db.Decimal(10, 2)
  taxAmount           Decimal     @default(0) @db.Decimal(10, 2)
  // What the organization keeps: subtotal under PASS, subtotal minus fees under ABSORB
  orgReceives         Decimal     @default(0) @db.Decimal(10, 2)
  feeMode             FeeMode     @default(PASS)
  currency            String      @default("usd")
  quantity            Int
  status              OrderStatus @default(PENDING)
  paidAt              DateTime? // when the money moved (COMPLETED)
  dueAt               DateTime? // application PAYMENT_DUE clock
  // Checkout opt-ins (spec 007). Recorded here and applied to the Contact only
  // once payment completes, so an abandoned or forged checkout can never
  // create an account or consent for someone else's email.
  optInAccount        Boolean     @default(false)
  optInMarketing      Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event       Event               @relation(fields: [eventId], references: [id])
  contact     Contact             @relation(fields: [contactId], references: [id])
  application Application?        @relation(fields: [applicationId], references: [id])
  tickets     Ticket[]
  items       OrderItem[]
  addOns      OrderAddOn[]
  payment     PaymentTransaction?
  refunds     Refund[]

  @@index([eventId])
  @@index([contactId])
  @@index([status])
  @@index([orderRef])
  @@index([kind, status])
  @@index([createdAt])
  @@index([status, createdAt]) // spec 020: abandoned-checkout sweep
  @@index([contactId, eventId, status]) // spec 020: per-buyer hold cap
}

// A line on an order: a ticket tier, an application tier (spec 024), or a
// signed adjustment / waiver on an application order (unitPrice × 1,
// description = reason). Exactly one tier line per application order.
model OrderItem {
  id                String        @id @default(cuid())
  orderId           String
  kind              OrderItemKind @default(TICKET_TIER)
  priceTierId       String?
  applicationTierId String?
  description       String? // tier name snapshot, adjustment reason
  quantity          Int
  unitPrice         Decimal       @db.Decimal(10, 2)
  platformFee       Decimal       @default(0) @db.Decimal(10, 2)
  processingFee     Decimal       @default(0) @db.Decimal(10, 2)
  tax               Decimal       @default(0) @db.Decimal(10, 2)
  createdById       String? // adjustment author
  createdAt         DateTime      @default(now())

  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  priceTier       PriceTier?       @relation(fields: [priceTierId], references: [id])
  applicationTier ApplicationTier? @relation(fields: [applicationTierId], references: [id])

  @@unique([orderId, priceTierId])
  @@index([orderId])
  @@index([priceTierId])
  @@index([applicationTierId])
}

model Ticket {
  id           String       @id @default(cuid())
  orderId      String
  eventId      String
  priceTierId  String
  contactId    String
  ticketNumber Int
  pricePaid    Decimal      @db.Decimal(10, 2)
  barcode      String       @unique
  qrCodeJwt    String?
  status       TicketStatus @default(VALID)
  redeemedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order     Order     @relation(fields: [orderId], references: [id])
  event     Event     @relation(fields: [eventId], references: [id])
  priceTier PriceTier @relation(fields: [priceTierId], references: [id])
  contact   Contact   @relation(fields: [contactId], references: [id])
  refunds   Refund[]

  @@unique([eventId, ticketNumber])
  @@index([orderId])
  @@index([eventId])
  @@index([priceTierId])
  @@index([contactId])
  @@index([barcode])
  @@index([status])
}

model PaymentTransaction {
  id                    String                @id @default(cuid())
  orderId               String                @unique
  stripePaymentIntentId String?               @unique
  amount                Decimal               @db.Decimal(10, 2)
  currency              String                @default("usd")
  status                PaymentStatus         @default(PENDING)
  failureReason         String?
  // Spec 010 phase 2: destination charge routing, set at creation only.
  // null stripeAccountId = charged on the platform account (every pre-Connect order).
  stripeAccountId       String?
  applicationFee        Decimal?              @db.Decimal(10, 2) // dollars kept by the platform (fees + tax)
  // Spec 024: a payment recorded outside Stripe (cheque, cash, comped) on an
  // application order has no Stripe id and carries the method instead.
  source                PaymentSource         @default(STRIPE)
  offlineMethod         OfflinePaymentMethod?
  offlineReference      String?
  recordedById          String?

  createdAt DateTime @default(now())
  // NO updatedAt — append-only per constitution

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
}

model Refund {
  id             String       @id @default(cuid())
  orderId        String
  ticketId       String? // null = full order refund
  orderAddOnId   String? // add-on line refund (spec 012)
  stripeRefundId String?
  amount         Decimal      @db.Decimal(10, 2)
  reason         String?
  status         RefundStatus @default(PENDING)
  initiatedBy    String? // userId of admin who initiated, null for customer self-service
  manual         Boolean      @default(false) // recorded refund on an offline-paid order, no Stripe call (spec 024)

  createdAt DateTime @default(now())
  // NO updatedAt — append-only ledger

  order      Order       @relation(fields: [orderId], references: [id])
  ticket     Ticket?     @relation(fields: [ticketId], references: [id])
  orderAddOn OrderAddOn? @relation(fields: [orderAddOnId], references: [id])

  @@index([orderId])
  @@index([ticketId])
  @@index([orderAddOnId])
  @@index([stripeRefundId])
}

// ──────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────

// Staff roles. UNASSIGNED is the default for a freshly signed-in User with no
// OrganizationMember row yet; it grants nothing. Buyers are not Users.
enum UserRole {
  UNASSIGNED
  ORGANIZER
  ADMIN
  SYSTEM_ADMIN
}

enum MemberRole {
  ORGANIZER
  ADMIN
}

// Spec 022: FREE = no subscription, platform fee only. STARTER = the paid
// plan (phase 2, price from JUMP_STARTER_PRICE_ID).
enum PlatformPlan {
  FREE
  STARTER
}

enum BuyerTokenPurpose {
  WELCOME
  LOGIN
}

enum DomainStatus {
  PENDING
  VERIFIED
  ACTIVE
  FAILED
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

// Light/dark mode enforced on an organization's public pages. SYSTEM follows the visitor's OS.
enum TaxSource {
  STRIPE
  MANUAL
}

enum ThemeMode {
  LIGHT
  DARK
  SYSTEM
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED // application order closed before any charge (rejected, withdrawn, replaced draft)
  REFUNDED
  PARTIALLY_REFUNDED
}

enum OrderKind {
  TICKET
  APPLICATION
}

enum OrderItemKind {
  TICKET_TIER
  APPLICATION_TIER
  ADJUSTMENT // signed manual line on an application order (negative = discount)
  WAIVER // the waived balance, recorded when the balance is waived
}

enum TierVisibility {
  PUBLIC
  PRIVATE
  HIDDEN
}

enum TicketStatus {
  VALID
  REDEEMED
  EXPIRED
  VOIDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

// ─── Applications (spec 011) ───────────────────────────────────────────────
// Per-event application forms for vendors, sponsors (PAID, tiered, capacity
// on approval) and press / panels / creators (FREE). Review status and payment
// status are independent columns. Capacity is consumed by approval, never by
// submission, so waitlisting works. Money columns are used from phase 2.

enum ApplicationFormKind {
  PAID
  FREE
}

enum ApplicationFormStatus {
  DRAFT
  OPEN
  CLOSED
}

enum ChargeTiming {
  SUBMIT
  APPROVAL
}

enum FeeMode {
  PASS
  ABSORB
}

enum OverduePolicy {
  WITHDRAW
  HOLD
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  WAITLISTED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ApplicationPayment {
  NOT_REQUIRED
  AWAITING_CARD
  CARD_ON_FILE
  PROCESSING
  PAID
  PAYMENT_DUE
  REFUNDED
  PARTIALLY_REFUNDED
}

enum CapacitySlot {
  NONE
  RESERVED
  APPROVED
}

enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  SINGLE_CHOICE
  MULTI_CHOICE
  CHECKBOX
  URL
  EMAIL
  PHONE
  NUMBER
  PHOTO
}

enum ApplicationAction {
  RECEIVED
  APPROVED
  REJECTED
  WAITLISTED
  WITHDRAWN
  PAYMENT_DUE
  ADD_ONS_CHANGED // spec 012 phase 2: organizer edited the add-on lines before payment
  TIER_CHANGED // spec 018 phase 3: organizer moved the application to another tier
  ADJUSTED // spec 018 phase 3: manual adjustment line added or removed
  WAIVED // spec 018 phase 3: balance waived (ADMIN)
  OFFLINE_PAID // spec 018 phase 3: payment recorded outside Stripe (ADMIN)
  MANUAL_REFUND // spec 018 phase 3: refund recorded on an offline-paid application
}

enum EmailSubscribedSource {
  CHECKOUT
  APPLY
  ADMIN
  IMPORT
}

// ─── Legal acceptances (spec 023 §8.1, built by spec 024 phase 3) ───────────
// Who accepted which document version, when, from where. Append-only, like
// PaymentTransaction: never updated, kept for the life of the related ledger
// row. `ipHash` is sha256(ip + day + salt); the raw IP is never stored.

enum LegalSubject {
  USER
  CONTACT
  ANONYMOUS_EMAIL
}

enum LegalDocument {
  TERMS
  PRIVACY
  ORGANIZER_TERMS
  CARD_AUTHORIZATION
  SUBSCRIPTION_TERMS
  CONNECT_TERMS
  MARKETING
}

enum LegalSource {
  CHECKOUT
  APPLY
  SIGNUP
  SUBSCRIBE
  CONNECT
  ACCOUNT
  ADMIN_INTERSTITIAL
}

model LegalAcceptance {
  id             String        @id @default(cuid())
  subjectType    LegalSubject
  subjectId      String? // User.id or Contact.id; null when only an email is known
  email          String // as entered; lets a pending checkout be matched later
  organizationId String? // tenant context
  document       LegalDocument
  version        String
  source         LegalSource
  referenceType  String? // 'Order' | 'Application' | 'Organization' | 'CheckoutSession'
  referenceId    String?
  ipHash         String? // sha256(ip + daily salt); never the raw IP
  userAgent      String? // truncated to 255
  presentedText  String? // exact label shown for CARD_AUTHORIZATION (amount, trigger, window)
  acceptedAt     DateTime      @default(now())

  @@index([email, document])
  @@index([subjectType, subjectId])
  @@index([referenceType, referenceId])
}

enum PaymentSource {
  STRIPE
  OFFLINE
}

enum OfflinePaymentMethod {
  CHEQUE
  CASH
  BANK_TRANSFER
  COMPED
  OTHER
}

enum WithdrawnBy {
  ORGANIZER
  APPLICANT
  SYSTEM
}

model ApplicationForm {
  id                    String                @id @default(cuid())
  eventId               String
  kind                  ApplicationFormKind
  name                  String
  slug                  String
  intro                 String?
  status                ApplicationFormStatus @default(DRAFT)
  opensAt               DateTime?
  closesAt              DateTime?
  chargeTiming          ChargeTiming          @default(APPROVAL)
  feeMode               FeeMode               @default(PASS)
  taxable               Boolean               @default(false)
  paymentDueDays        Int                   @default(7)
  overduePolicy         OverduePolicy         @default(WITHDRAW)
  displayOrder          Int                   @default(0)
  createdFromTemplateId String? // spec 019: informational, no relation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event        Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tiers        ApplicationTier[]
  questions    ApplicationQuestion[]
  applications Application[]

  @@unique([eventId, slug])
  @@index([eventId, status])
}

model ApplicationTier {
  id               String  @id @default(cuid())
  formId           String
  name             String
  description      String?
  price            Decimal @db.Decimal(10, 2)
  quantityTotal    Int
  quantityApproved Int     @default(0) // slots held by approved (paid or free) applications
  quantityReserved Int     @default(0) // slots held while a charge is in flight or payment is due
  displayOrder     Int     @default(0)
  isActive         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  form         ApplicationForm        @relation(fields: [formId], references: [id], onDelete: Cascade)
  applications Application[]
  addOns       ApplicationTierAddOn[]
  orderItems   OrderItem[]

  @@index([formId])
}

model ApplicationQuestion {
  id           String       @id @default(cuid())
  formId       String
  label        String
  helpText     String?
  type         QuestionType
  required     Boolean      @default(false)
  options      String[]     @default([])
  displayOrder Int          @default(0)
  pinned       Boolean      @default(false) // spec 019: shown as a column on the submissions list (≤ 2 per form)
  archivedAt   DateTime? // archived, never deleted, once answers exist

  form    ApplicationForm     @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers ApplicationAnswer[]

  @@index([formId])
}

// Reusable per organization + contact: business identity shown to the
// organizer (and, with spec 014, optionally to attendees).
model ApplicantProfile {
  id             String  @id @default(cuid())
  organizationId String
  contactId      String
  businessName   String
  description    String?
  website        String?
  socials        Json? // { instagram, tiktok, facebook, x, youtube, other }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact                 @relation(fields: [contactId], references: [id], onDelete: Cascade)
  images       ApplicantProfileImage[]
  applications Application[]

  @@unique([organizationId, contactId])
}

model ApplicantProfileImage {
  id           String @id @default(cuid())
  profileId    String
  imageId      String
  displayOrder Int    @default(0)

  profile ApplicantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  image   Image            @relation(fields: [imageId], references: [id])

  @@unique([profileId, imageId])
}

model Application {
  id             String             @id @default(cuid())
  formId         String
  eventId        String
  organizationId String
  contactId      String
  profileId      String
  tierId         String?
  status         ApplicationStatus  @default(DRAFT)
  // Fine-grained payment state machine; the coarse money state is Order.status
  // (spec 024), written in the same transaction through orderStatusFor().
  paymentStatus  ApplicationPayment @default(NOT_REQUIRED)
  capacitySlot   CapacitySlot       @default(NONE)

  // Money lives on `order` (spec 024): amount snapshot as order lines,
  // PaymentTransaction, Refund. PAID forms only; FREE forms have no order.

  // Apply-form opt-ins (spec 024 phase 3): recorded at submission, applied to
  // the Contact once the application first reaches SUBMITTED (never for an
  // abandoned DRAFT). Both only ever turn the contact's flags on.
  optInAccount    Boolean   @default(false)
  optInMarketing  Boolean   @default(false)
  optInsAppliedAt DateTime?

  // Card on file (spec 011 phase 2)
  stripeCheckoutSessionId String? @unique
  stripePaymentMethodId   String?
  chargeAttempts          Int     @default(0)
  overdue                 Boolean @default(false) // set by the sweep when order.dueAt passes

  // Review
  submittedAt     DateTime?
  decidedAt       DateTime?
  decidedById     String?
  internalNote    String?
  withdrawnBy     WithdrawnBy?
  withdrawReason  String?
  boothLabel      String?
  tags            String[]     @default([]) // spec 019 phase 3: free-form organizer tags
  checkedInAt     DateTime? // spec 019 phase 3: on-site check-in (APPROVED only)
  checkedOutAt    DateTime?
  statusTokenHash String       @unique // guest status-page token, sha256 of the raw token

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  form      ApplicationForm       @relation(fields: [formId], references: [id])
  event     Event                 @relation(fields: [eventId], references: [id])
  contact   Contact               @relation(fields: [contactId], references: [id])
  profile   ApplicantProfile      @relation(fields: [profileId], references: [id])
  tier      ApplicationTier?      @relation(fields: [tierId], references: [id])
  answers   ApplicationAnswer[]
  decisions ApplicationDecision[]
  order     Order?

  @@index([eventId, status])
  @@index([formId, status])
  @@index([contactId])
  @@index([organizationId])
  @@index([organizationId, submittedAt]) // spec 019: org-wide Participants list
  @@index([paymentStatus])
  @@index([tags], type: Gin)
}

model ApplicationAnswer {
  id            String  @id @default(cuid())
  applicationId String
  questionId    String
  valueText     String?
  valueJson     Json? // MULTI_CHOICE selections
  imageId       String? // PHOTO

  application Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question    ApplicationQuestion @relation(fields: [questionId], references: [id])
  image       Image?              @relation(fields: [imageId], references: [id])

  @@unique([applicationId, questionId])
}

model ApplicationDecision {
  id            String            @id @default(cuid())
  applicationId String
  action        ApplicationAction
  byUserId      String? // null = system (overdue sweep) or the applicant
  note          String?
  emailSubject  String?
  emailBody     String?
  createdAt     DateTime          @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// Spec 019 phase 2: a reusable form definition per organization. A snapshot
// (tiers and questions as JSON), not a live form — materialised into an
// ApplicationForm through ApplicationFormService._materialise.
model ApplicationFormTemplate {
  id             String              @id @default(cuid())
  organizationId String
  name           String
  kind           ApplicationFormKind
  definition     Json // { intro, chargeTiming, feeMode, taxable, paymentDueDays, overduePolicy, tiers: [...], questions: [...] }
  sourceFormId   String? // informational: the form it was saved from
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId, updatedAt])
}

model ApplicationMessageTemplate {
  id             String            @id @default(cuid())
  organizationId String
  action         ApplicationAction
  subject        String
  body           String // plain text with {{merge.fields}}; rendered into the branded email shell
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, action])
}

// ---------------------------------------------------------------------------
// Add-ons (spec 012): products sold alongside a ticket tier or an application
// tier (booth power, extra badges, parking). Lines live on their own tables so
// ticket creation and Order.quantity never see them.
// ---------------------------------------------------------------------------

enum AddOnScope {
  TICKET
  APPLICATION
  BOTH
}

model AddOn {
  id               String     @id @default(cuid())
  eventId          String
  name             String
  description      String?
  price            Decimal    @db.Decimal(10, 2)
  scope            AddOnScope @default(BOTH)
  allTiers         Boolean    @default(true) // false = only the attached tiers offer it
  quantityTotal    Int? // null = unlimited
  quantitySold     Int        @default(0)
  quantityReserved Int        @default(0)
  maxPerOrder      Int?
  taxable          Boolean    @default(true)
  isActive         Boolean    @default(true)
  displayOrder     Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event            Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  priceTiers       PriceTierAddOn[]
  applicationTiers ApplicationTierAddOn[]
  orderLines       OrderAddOn[]

  @@index([eventId, isActive])
}

model PriceTierAddOn {
  priceTierId String
  addOnId     String

  priceTier PriceTier @relation(fields: [priceTierId], references: [id], onDelete: Cascade)
  addOn     AddOn     @relation(fields: [addOnId], references: [id], onDelete: Cascade)

  @@id([priceTierId, addOnId])
  @@index([addOnId])
}

model ApplicationTierAddOn {
  applicationTierId String
  addOnId           String

  tier  ApplicationTier @relation(fields: [applicationTierId], references: [id], onDelete: Cascade)
  addOn AddOn           @relation(fields: [addOnId], references: [id], onDelete: Cascade)

  @@id([applicationTierId, addOnId])
  @@index([addOnId])
}

model OrderAddOn {
  id            String    @id @default(cuid())
  orderId       String
  addOnId       String
  quantity      Int
  unitPrice     Decimal   @db.Decimal(10, 2) // listed price at purchase, immutable
  platformFee   Decimal   @default(0) @db.Decimal(10, 2)
  processingFee Decimal   @default(0) @db.Decimal(10, 2)
  tax           Decimal   @default(0) @db.Decimal(10, 2)
  refundedAt    DateTime?
  createdAt     DateTime  @default(now())

  // Add-on lines of ticket orders and application orders alike (spec 024).
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  addOn   AddOn    @relation(fields: [addOnId], references: [id])
  refunds Refund[]

  @@unique([orderId, addOnId])
  @@index([addOnId])
}
